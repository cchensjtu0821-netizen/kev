mily=Noto Sans CJK SC;fontSize=25;fontColor=#20766c;spacing=0;" vertex="1" parent="1"><mxGeometry x="776" y="1315.5" width="141.35" height="37.5" as="geometry" /></mxCell><mxCell id="140" value="候选项为给定类别或动作" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;strokeColor=none;fillColor=none;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#526379;spacing=0;" vertex="1" parent="1"><mxGeometry x="776" y="1357.8" width="248.0" height="33.0" as="geometry" /></mxCell><mxCell id="141" value="输出 argmax_j p_ij 与选项概率" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;strokeColor=none;fillColor=none;fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#15263d;spacing=0;" vertex="1" parent="1"><mxGeometry x="776" y="1395.7" width="321.95" height="34.5" as="geometry" /></mxCell><mxCell id="142" value="评分 Score" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;strokeColor=none;fillColor=none;fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#20766c;spacing=0;" vertex="1" parent="1"><mxGeometry x="1473" y="1315.5" width="127.95" height="37.5" as="geometry" /></mxCell><mxCell id="143" value="候选项为从低到高的等级" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;strokeColor=none;fillColor=none;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#526379;spacing=0;" vertex="1" parent="1"><mxGeometry x="1473" y="1357.8" width="248.0" height="33.0" as="geometry" /></mxCell><mxCell id="144" value="输出 Σ_j j · p_ij，等级从 0 开始" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;strokeColor=none;fillColor=none;fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#15263d;spacing=0;" vertex="1" parent="1"><mxGeometry x="1473" y="1395.7" width="335.77" height="34.5" as="geometry" /></mxCell><mxCell id="145" value="" style="shape=line;strokeColor=#bac7d5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="742" y="1323" width="0.01" height="104" as="geometry" /></mxCell><mxCell id="146" value="" style="shape=line;strokeColor=#bac7d5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1439" y="1323" width="0.01" height="104" as="geometry" /></mxCell><mxCell id="147" value="注：图示为当前文本版在线推理。纯注意力骨干也可用分块因果掩码实现问题隔离。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;strokeColor=none;fillColor=none;fontFamily=Noto Sans CJK SC;fontSize=21;fontColor=#526379;spacing=0;" vertex="1" parent="1"><mxGeometry x="62" y="1472.9" width="783.0" height="31.5" as="geometry" /></mxCell><mxCell id="148" value="算法直接读取候选概率，不进行逐 token 文本生成；题内选项顺序仍可能影响结果。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;rounded=0;strokeColor=none;fillColor=none;fontFamily=Noto Sans CJK SC;fontSize=21;fontColor=#526379;spacing=0;" vertex="1" parent="1"><mxGeometry x="62" y="1507.9" width="786.09" height="31.5" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>